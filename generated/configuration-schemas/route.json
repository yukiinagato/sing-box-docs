          "type": "boolean",
          "required": false,
          "description": "Enabled sniffers."
        },
        "timeout": {
          "type": "integer",
          "required": false,
          "description": "Timeout for sniffing."
        },
        "server": {
          "type": "string",
          "required": false,
          "description": "Specifies DNS server tag to use instead of selecting through DNS routing."
        },
        "strategy": {
          "type": "string",
          "required": false,
          "description": "DNS resolution strategy, available values are: prefer_ipv4, prefer_ipv6, ipv4_only, ipv6_only."
        },
        "disable_cache": {
          "type": "boolean",
          "required": false,
          "since": "1.12.0"
        },
