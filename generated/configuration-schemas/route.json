          "type": "string",
          "required": false,
          "default": "Reply with TCP RST for TCP connections, and ICMP port unreachable for UDP packets",
          "description": "For TCP and UDP connections: default: Reply with TCP RST for TCP connections, and ICMP port unreachable for UDP packets."
        },
        "no_drop": {
          "type": "object",
          "required": false,
          "description": "If not enabled, method will be temporarily overwritten to drop after 50 triggers in 30s."
        },
