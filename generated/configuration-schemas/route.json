          "type": "string",
          "required": false,
          "description": "See Dial Fields for details."
        },
        "udp_disable_domain_unmapping": {
          "type": "boolean",
          "required": false,
          "description": "If enabled, for UDP proxy requests addressed to a domain, the original packet address will be sent in the response instead of the mapped domain."
        },
        "udp_connect": {
          "type": "array_object",
          "required": false,
          "description": "If enabled, attempts to connect UDP connection to the destination instead of listen."
        },
        "udp_timeout": {
          "type": "integer",
          "required": false,
          "default": "Port Protocol 53 dns 123 ntp 443 quic 3478 stun",
          "description": "Timeout for UDP connections."
        },
        "tls_fragment": {
          "type": "boolean",
          "required": false,
          "since": "1.12.0",
          "description": "This feature is intended to circumvent simple firewalls based on plaintext packet matching, and should not be used to circumvent real censorship."
        },
        "tls_fragment_fallback_delay": {
          "type": "boolean",
          "required": false,
          "since": "1.12.0",
          "description": "500ms is used by default."
        },
        "tls_record_fragment": {
          "type": "boolean",
          "required": false,
          "since": "1.12.0",
          "description": "sniff { \"action\": \"sniff\", \"sniffer\": [], \"timeout\": \"\" } sniff performs protocol sniffing on connections."
        },
