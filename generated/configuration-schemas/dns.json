            {
              "type": "conflicts_with",
              "field": "disable_expire"
            }
          ],
          "since": "1.14.0",
          "description": "When a cached DNS entry has expired but is still within the timeout window, the stale response is returned immediately while a background refresh is triggered."
        },
        "reverse_mapping": {
          "type": "string",
