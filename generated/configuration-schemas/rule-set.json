      "title": "Headless Rule",
      "fields": {
        "query_type": {
          "type": "array_object",
          "required": false,
          "description": "Changes in sing-box 1.14.0 When a DNS rule references this rule-set, this field now also applies when the DNS rule is matched from an internal domain resolution that does not target a specific DNS server."
        },
        "network": {
          "type": "string",
          "required": false,
          "description": "tcp or udp."
        },
        "domain": {
          "type": "string",
          "required": false,
          "description": "Match full domain."
        },
        "domain_suffix": {
          "type": "string",
          "required": false,
          "description": "Match domain suffix."
        },
        "domain_keyword": {
          "type": "string",
          "required": false,
          "description": "Match domain using keyword."
        },
        "domain_regex": {
          "type": "string",
          "required": false,
          "description": "Match domain using regular expression."
        },
        "source_ip_cidr": {
          "type": "integer",
          "required": false,
          "description": "Match source IP CIDR."
        },
        "ip_cidr": {
          "type": "integer",
          "required": false,
          "description": "ip_cidr is an alias for source_ip_cidr when rule_set_ipcidr_match_source enabled in route/DNS rules."
        },
        "source_port": {
          "type": "integer",
          "required": false,
          "description": "Match source port."
        },
        "source_port_range": {
          "type": "integer",
          "required": false,
          "description": "Match source port range."
        },
        "port": {
          "type": "integer",
          "required": false,
          "description": "Match port."
        },
        "port_range": {
          "type": "integer",
          "required": false,
          "description": "Match port range."
        },
        "process_name": {
          "type": "string",
          "required": false,
          "description": "Only supported on Linux, Windows, and macOS."
        },
        "process_path": {
          "type": "string",
          "required": false,
          "description": "Only supported on Linux, Windows, and macOS."
        },
        "process_path_regex": {
          "type": "string",
          "required": false,
          "since": "1.10.0",
          "description": "Match process path using regular expression."
        },
        "package_name": {
          "type": "string",
          "required": false,
          "description": "Match android package name."
        },
        "package_name_regex": {
          "type": "string",
          "required": false,
          "since": "1.14.0"
        },
        "network_type": {
          "type": "string",
          "required": false,
          "allowedValues": [
            "cellular",
            "ethernet",
            "other",
            "wifi"
          ],
          "since": "1.11.0",
          "description": "Match network type."
        },
        "network_is_expensive": {
          "type": "string",
          "required": false,
          "since": "1.11.0",
          "description": "Match if network is considered Metered (on Android) or considered expensive, such as Cellular or a Personal Hotspot (on Apple platforms)."
        },
        "network_is_constrained": {
          "type": "string",
          "required": false,
          "since": "1.11.0",
          "description": "Match if network is in Low Data Mode."
        },
        "network_interface_address": {
          "type": "string",
          "required": false,
          "since": "1.13.0",
          "description": "Matches network interface (same values as network_type) address."
        },
        "default_interface_address": {
          "type": "string",
          "required": false,
          "since": "1.13.0",
          "description": "Match default interface address."
        },
        "wifi_ssid": {
          "type": "integer",
          "required": false,
          "description": "Only supported in graphical clients on Android and Apple platforms."
        },
        "wifi_bssid": {
          "type": "integer",
          "required": false,
          "description": "Only supported in graphical clients on Android and Apple platforms."
        },
        "invert": {
          "type": "string",
          "required": false,
          "description": "Invert match result."
        },
        "type": {
          "type": "string",
          "required": false,
          "description": "logical"
        },
        "mode": {
          "type": "string",
          "required": true,
          "description": "Required and or or"
        },
        "rules": {
          "type": "array_object",
          "required": true,
          "description": "Required Included rules."
        }
      },
