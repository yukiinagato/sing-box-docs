      "page_id": "tailscale",
      "source_path": "configuration/endpoint/tailscale/index.html",
      "title": "Tailscale",
      "fields": {
        "state_directory": {
          "type": "string",
          "required": false,
          "description": "The directory where the Tailscale state is stored."
        },
        "auth_key": {
          "type": "string",
          "required": false,
          "description": "Note Auth key is not required."
        },
        "control_url": {
          "type": "string",
          "required": false,
          "description": "The coordination server URL."
        },
        "ephemeral": {
          "type": "string",
          "required": false,
          "description": "Indicates whether the instance should register as an Ephemeral node (https://tailscale.com/s/ephemeral-nodes)."
        },
        "hostname": {
          "type": "string",
          "required": false,
          "description": "The hostname of the node."
        },
        "accept_routes": {
          "type": "string",
          "required": false,
          "description": "Indicates whether the node should accept routes advertised by other nodes."
        },
        "exit_node": {
          "type": "string",
          "required": false,
          "description": "The exit node name or IP address to use."
        },
        "exit_node_allow_lan_access": {
          "type": "boolean",
          "required": false,
          "description": "Note When the exit node does not have a corresponding advertised route, private traffics cannot be routed to the exit node even if exit_node_allow_lan_access is set."
        },
        "advertise_routes": {
          "type": "string",
          "required": false,
          "description": "CIDR prefixes to advertise into the Tailscale network as reachable through the current node."
        },
        "advertise_exit_node": {
          "type": "string",
          "required": false,
          "description": "Indicates whether the node should advertise itself as an exit node."
        },
        "advertise_tags": {
          "type": "string",
          "required": false,
          "since": "1.13.0",
          "description": "Example: [\"tag:server\"]"
        },
        "relay_server_port": {
          "type": "integer",
          "required": false,
          "since": "1.13.0"
        },
        "relay_server_static_endpoints": {
          "type": "string",
          "required": false,
          "since": "1.13.0"
        },
        "system_interface": {
          "type": "string",
          "required": false,
          "since": "1.13.0"
        },
        "system_interface_name": {
          "type": "string",
          "required": false,
          "since": "1.13.0",
          "description": "By default, tailscale (or utun on macOS) will be used."
        },
        "system_interface_mtu": {
          "type": "integer",
          "required": false,
          "since": "1.13.0",
          "description": "By default, Tailscale's own MTU is used."
        },
        "udp_timeout": {
          "type": "integer",
          "required": false,
          "description": "UDP NAT expiration time."
        }
      },
