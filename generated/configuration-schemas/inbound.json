    {
      "page_id": "tun",
      "source_path": "configuration/inbound/tun/index.html",
      "title": "Tun",
      "fields": {
        "interface_name": {
          "type": "string",
          "required": false,
          "description": "Virtual device name, automatically selected if empty."
        },
        "address": {
          "type": "string",
          "required": false,
          "since": "1.10.0"
        },
        "inet4_address": {
          "type": "string",
          "required": false,
          "deprecated": true,
          "description": "Deprecated in sing-box 1.10.0 inet4_address is merged to address and will be removed in sing-box 1.12.0."
        },
        "inet6_address": {
          "type": "string",
          "required": false,
          "deprecated": true,
          "description": "Deprecated in sing-box 1.10.0 inet6_address is merged to address and will be removed in sing-box 1.12.0."
        },
        "mtu": {
          "type": "integer",
          "required": false,
          "description": "The maximum transmission unit."
        },
        "gso": {
          "type": "string",
          "required": false,
          "since": "1.8.0",
          "deprecated": true,
          "description": "Deprecated in sing-box 1.11.0 GSO has no advantages for transparent proxy scenarios, is deprecated and no longer works, and will be removed in sing-box 1.12.0."
        },
        "auto_route": {
          "type": "string",
          "required": false,
          "description": "Set the default route to the Tun."
        },
        "iproute2_table_index": {
          "type": "string",
          "required": false,
          "since": "1.10.0",
          "description": "2022 is used by default."
        },
        "iproute2_rule_index": {
          "type": "string",
          "required": false,
          "since": "1.10.0",
          "description": "9000 is used by default."
        },
        "auto_redirect": {
          "type": "object",
          "required": false,
          "dependencies": [
            {
              "type": "conflicts_with",
              "field": "route"
            }
          ],
          "since": "1.10.0",
          "description": "Improve TUN routing and performance using nftables."
        },
        "auto_redirect_input_mark": {
          "type": "integer",
          "required": false,
          "since": "1.10.0",
          "description": "0x2023 is used by default."
        },
        "auto_redirect_output_mark": {
          "type": "integer",
          "required": false,
          "since": "1.10.0",
          "description": "0x2024 is used by default."
        },
        "auto_redirect_reset_mark": {
          "type": "integer",
          "required": false,
          "since": "1.13.0",
          "description": "0x2025 is used by default."
        },
        "auto_redirect_nfqueue": {
          "type": "string",
          "required": false,
          "since": "1.13.0",
          "description": "100 is used by default."
        },
        "auto_redirect_iproute2_fallback_rule_index": {
          "type": "string",
          "required": false,
          "since": "1.12.18",
          "description": "This rule is checked after system default rules (32766: main, 32767: default), routing traffic to the sing-box table only when no route is found in system tables."
        },
        "exclude_mptcp": {
          "type": "string",
          "required": false,
          "since": "1.13.0",
          "description": "MPTCP cannot be transparently proxied due to protocol limitations."
        },
        "loopback_address": {
          "type": "string",
          "required": false,
          "since": "1.12.0",
          "description": "Setting option value to 10.7.0.1 achieves the same behavior as SideStore/StosVPN."
        },
        "strict_route": {
          "type": "boolean",
          "required": false,
          "description": "Enforce strict routing rules when auto_route is enabled: In Linux: Let unsupported network unreachable For legacy reasons, when neither strict_route nor auto_redirect are enabled, all ICMP traffic will not go through TUN."
        },
        "route_address": {
          "type": "string",
          "required": false,
          "since": "1.10.0"
        },
        "inet4_route_address": {
          "type": "string",
          "required": false,
          "deprecated": true,
          "description": "Deprecated in sing-box 1.10.0 inet4_route_address is deprecated and will be removed in sing-box 1.12.0, please use route_address instead."
        },
        "inet6_route_address": {
          "type": "string",
          "required": false,
          "deprecated": true,
          "description": "Deprecated in sing-box 1.10.0 inet6_route_address is deprecated and will be removed in sing-box 1.12.0, please use route_address instead."
        },
        "route_exclude_address": {
          "type": "string",
          "required": false,
          "since": "1.10.0"
        },
        "inet4_route_exclude_address": {
          "type": "string",
          "required": false,
          "deprecated": true,
          "description": "Deprecated in sing-box 1.10.0 inet4_route_exclude_address is deprecated and will be removed in sing-box 1.12.0, please use route_exclude_address instead."
        },
        "inet6_route_exclude_address": {
          "type": "string",
          "required": false,
          "deprecated": true,
          "description": "Deprecated in sing-box 1.10.0 inet6_route_exclude_address is deprecated and will be removed in sing-box 1.12.0, please use route_exclude_address instead."
        },
        "route_address_set": {
          "type": "object",
          "required": false,
          "dependencies": [
            {
              "type": "conflicts_with",
              "field": "route"
            }
          ],
          "since": "1.11.0",
          "description": "With auto_redirect enabledWithout auto_redirect enabled Since sing-box 1.10.0 Only supported on Linux with nftables and requires auto_route and auto_redirect enabled."
        },
        "route_exclude_address_set": {
          "type": "string",
          "required": false,
          "since": "1.11.0",
          "description": "With auto_redirect enabledWithout auto_redirect enabled Since sing-box 1.10.0 Only supported on Linux with nftables and requires auto_route and auto_redirect enabled."
        },
        "endpoint_independent_nat": {
          "type": "string",
          "required": false,
          "description": "This item is only available on the gvisor stack, other stacks are endpoint-independent NAT by default."
        },
        "udp_timeout": {
          "type": "integer",
          "required": false,
          "description": "UDP NAT expiration time."
        },
        "stack": {
          "type": "string",
          "required": false,
